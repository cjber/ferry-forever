<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Frame name="FerryForeverDockPinTemplate" inherits="BaseHighlightableMapPoiPinTemplate"
		mixin="FerryForeverDockPinMixin" enableMouse="true" virtual="true">
		<Layers>
			<!-- The map legend's glow for a related pin (LegendHighlightablePoiPinMixin:ShowMapLegendGlow). -->
			<Layer level="BACKGROUND">
				<Texture parentKey="Glow" atlas="UI-QuestPoi-OuterGlow" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="-18" y="18"/>
						<Anchor point="BOTTOMRIGHT" x="18" y="-18"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>
	<Frame name="FerryForeverPortalPinTemplate" inherits="BaseHighlightableMapPoiPinTemplate"
		mixin="FerryForeverPortalPinMixin" enableMouse="true" virtual="true"/>
	<Frame name="FerryForeverFlightPinTemplate" inherits="FlightPointPinTemplate"
		mixin="FerryForeverFlightPinMixin" virtual="true"/>
	<Frame name="FerryForeverTransportPinTemplate" mixin="FerryForeverTransportPinMixin" virtual="true"/>
	<Frame name="FerryForeverRoutePinTemplate" mixin="FerryForeverRoutePinMixin" virtual="true"/>
	<Frame name="FerryForeverGoalPinTemplate" mixin="FerryForeverGoalPinMixin" enableMouse="true" virtual="true">
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Texture" setAllPoints="true"/>
			</Layer>
		</Layers>
	</Frame>
</Ui>
