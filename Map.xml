<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Frame name="ShortestPathForeverDockPinTemplate" inherits="BaseHighlightableMapPoiPinTemplate"
		mixin="ShortestPathForeverDockPinMixin" enableMouse="true" virtual="true">
		<Layers>
			<!-- The map legend's glow for a related pin (LegendHighlightablePoiPinMixin:ShowMapLegendGlow). -->
			<Layer level="BACKGROUND">
				<Texture parentKey="Glow" atlas="UI-QuestPoi-OuterGlow" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="-18" y="18"/>
						<Anchor point="BOTTOMRIGHT" x="18" y="-18"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>
	<Frame name="ShortestPathForeverPortalPinTemplate" inherits="BaseHighlightableMapPoiPinTemplate"
		mixin="ShortestPathForeverPortalPinMixin" enableMouse="true" virtual="true"/>
	<Frame name="ShortestPathForeverPingPinTemplate" inherits="MapPinPingTemplate" virtual="true"/>
	<Frame name="ShortestPathForeverFlightPinTemplate" inherits="FlightPointPinTemplate"
		mixin="ShortestPathForeverFlightPinMixin" virtual="true"/>
	<Frame name="ShortestPathForeverTransportPinTemplate" mixin="ShortestPathForeverTransportPinMixin" virtual="true"/>
	<Frame name="ShortestPathForeverRoutePinTemplate" mixin="ShortestPathForeverRoutePinMixin" virtual="true"/>
	<Frame name="ShortestPathForeverGoalPinTemplate" mixin="ShortestPathForeverGoalPinMixin" enableMouse="true" virtual="true">
		<Layers>
			<!-- A numbered stop of a multi-stop journey: the Adventure Guide's ring over a dark disc (cut round with the
			     stock portrait mask), Blizzard's gold numeral in it, and the quest POI's glow on hover. -->
			<Layer level="BACKGROUND">
				<Texture parentKey="Disc" hidden="true">
					<Size x="22" y="22"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
					<Color r="0" g="0" b="0" a="0.75"/>
				</Texture>
				<MaskTexture parentKey="DiscMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Disc"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Disc"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="Disc"/>
					</MaskedTextures>
				</MaskTexture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Texture" setAllPoints="true"/>
			</Layer>
			<Layer level="ARTWORK" textureSubLevel="1">
				<Texture parentKey="Glow" atlas="UI-QuestPoi-InnerGlow" alphaMode="ADD" hidden="true">
					<Size x="30" y="30"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="Numeral" hidden="true">
					<Size x="22" y="25"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>
</Ui>
