<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shortest Path Forever baker: Mappster's extractor and navmesh baker (MIT) on Ladislav Zezula's CascLib (MIT, P/Invoke).
       MappsterDir points at a Mappster checkout with mappster.patch applied; its GUI, tools and the WoW-Tools
       CascLib submodule are not compiled. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MapExtract</RootNamespace>
    <Deterministic>true</Deterministic>
    <MappsterDir Condition="'$(MappsterDir)' == ''">$(MSBuildThisFileDirectory)../Mappster</MappsterDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MappsterDir)/Extractor/*.cs" Exclude="$(MappsterDir)/Extractor/Extractor.Casc.cs" />
    <Compile Include="$(MappsterDir)/Nav/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DBCD" Version="2.3.0" />
    <PackageReference Include="DotRecast.Core" Version="2026.3.1" />
    <PackageReference Include="DotRecast.Detour" Version="2026.3.1" />
    <PackageReference Include="DotRecast.Recast" Version="2026.3.1" />
  </ItemGroup>
</Project>
