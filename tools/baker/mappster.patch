new file mode 100644
index 0000000..f5a0b66
--- /dev/null
+++ b/Extractor/FileSource.cs
@@ -0,0 +1,15 @@
+namespace MapExtract;
+
+/// Shortest Path Forever: the two calls the extractor makes on CASC storage, so the reader can be swapped.
+public interface IFileSource
+{
+    Stream OpenFile(int fileDataId);
+    bool FileExists(int fileDataId);
+}
+
+/// A file the root lists but local storage cannot supply (never downloaded, or evicted by the client's LRU).
+public sealed class MissingFileException(int fileDataId, Exception? inner = null)
+    : FileNotFoundException($"file {fileDataId} is not in local storage", inner)
+{
+    public int FileDataId { get; } = fileDataId;
+}
